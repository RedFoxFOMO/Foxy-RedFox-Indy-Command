# GEMINI_API_KEY: Optional. Enables the Strategic AI Advisor sidebar.
# All market, blueprint, cargo, and route tools work without it.
# If unset here, users can optionally paste their own key in the in-app "API Setup" modal.
GEMINI_API_KEY=""

# APP_URL: Optional public URL where this app is hosted (used as fallback server metadata).
APP_URL=""

# EVE_CLIENT_ID: Optional EVE Online Developer Portal OAuth2 PKCE Client ID.
# If set here, it takes priority over browser localStorage. Otherwise users can paste
# their own Client ID in the in-app "API Setup" modal with no terminal required.
EVE_CLIENT_ID=""
